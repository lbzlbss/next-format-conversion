    "agent:verify": "node scripts/agent/verify.mjs",
    "agent:loop": "node scripts/agent/loop.mjs",
    "agent:test": "node scripts/agent/test-report.mjs",
    "agent:git": "node scripts/agent/git-flow.mjs",
    "agent:perf": "node scripts/agent/perf-report.mjs",
    "agent:archive": "node scripts/agent/archive.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@pdf-lib/fontkit": "^1.1.1",
